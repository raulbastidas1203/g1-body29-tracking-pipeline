+    frame = env.render()
+    if frame is not None:
+      frames.append(frame[0] if frame.ndim == 4 else frame)
+
+    completed_steps = step + 1
+    if bool(dones[0].item()):
+      terminated = bool(env.termination_manager.terminated[0].item())
+      truncated = bool(env.termination_manager.time_outs[0].item())
+      terminated_early = terminated
+      truncated_early = truncated
+      if not cfg.no_terminations:
+        break
+
+  output_video = Path(cfg.output_video)
+  output_video.parent.mkdir(parents=True, exist_ok=True)
+  if not frames:
+    raise RuntimeError("No frames were recorded.")
+  media.write_video(str(output_video), frames, fps=env.metadata.get("render_fps", 50))
+
+  summary: dict[str, float | int | bool] = {
+    "num_steps_requested": int(num_steps),
+    "num_steps_recorded": int(completed_steps),
+    "num_frames": int(len(frames)),
+    "no_terminations": bool(cfg.no_terminations),
+    "terminated_early": terminated_early,
+    "truncated_early": truncated_early,
+    "mpkpe": float(np.mean(mpkpe_values)) if mpkpe_values else 0.0,
+    "r_mpkpe": float(np.mean(r_mpkpe_values)) if r_mpkpe_values else 0.0,
+    "joint_vel_error": float(np.mean(joint_vel_values)) if joint_vel_values else 0.0,
+    "ee_pos_error": float(np.mean(ee_pos_values)) if ee_pos_values else 0.0,
+    "ee_ori_error": float(np.mean(ee_ori_values)) if ee_ori_values else 0.0,
+  }
+
+  if cfg.output_metrics is not None:
+    output_metrics = Path(cfg.output_metrics)
+    output_metrics.parent.mkdir(parents=True, exist_ok=True)
+    output_metrics.write_text(json.dumps(summary, indent=2))
+
+  env.close()
+  return summary
+
+
+def main() -> None:
+  import mjlab.tasks  # noqa: F401
+
+  tracking_tasks = [t for t in list_tasks() if "Tracking" in t]
+  if not tracking_tasks:
+    print("No tracking tasks found.")
+    sys.exit(1)
+
+  chosen_task, remaining_args = tyro.cli(
+    tyro.extras.literal_type_from_choices(tracking_tasks),
+    add_help=False,
+    return_unknown_args=True,
+    config=mjlab.TYRO_FLAGS,
+  )
+
+  args = tyro.cli(
+    RecordRolloutOnnxConfig,
+    args=remaining_args,
+    prog=sys.argv[0] + f" {chosen_task}",
+    config=mjlab.TYRO_FLAGS,
+  )
+
+  summary = run_record_rollout_onnx(chosen_task, args)
+  print(json.dumps(summary, indent=2))
+
+
+if __name__ == "__main__":
+  main()
