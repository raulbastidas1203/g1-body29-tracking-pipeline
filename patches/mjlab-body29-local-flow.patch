@@ -0,0 +1,155 @@
+"""Compare PyTorch and ONNX tracking policies on identical observations."""
+
+from __future__ import annotations
+
+import json
+import sys
+from dataclasses import asdict, dataclass
+from pathlib import Path
+from typing import cast
+
+import numpy as np
+import onnxruntime as ort
+import torch
+import tyro
+
+from mjlab.envs import ManagerBasedRlEnv
+from mjlab.rl import MjlabOnPolicyRunner, RslRlVecEnvWrapper
+from mjlab.tasks.registry import list_tasks, load_env_cfg, load_rl_cfg, load_runner_cls
+from mjlab.tasks.tracking.mdp import MotionCommandCfg
+from mjlab.tasks.tracking.mdp.commands import MotionCommand
+from mjlab.utils.torch import configure_torch_backends
+
+
+@dataclass(frozen=True)
+class ComparePtOnnxConfig:
+  checkpoint_file: str
+  onnx_file: str
+  motion_file: str
+  num_envs: int = 1
+  num_steps: int = 200
+  device: str | None = None
+  output_file: str | None = None
+
+
+def run_compare_pt_onnx(
+  task_id: str, cfg: ComparePtOnnxConfig
+) -> dict[str, float | int]:
+  configure_torch_backends()
+  device = cfg.device or ("cuda:0" if torch.cuda.is_available() else "cpu")
+
+  env_cfg = load_env_cfg(task_id, play=False)
+  agent_cfg = load_rl_cfg(task_id)
+
+  motion_cmd = env_cfg.commands.get("motion")
+  if not isinstance(motion_cmd, MotionCommandCfg):
+    raise ValueError(f"Task {task_id} is not a tracking task.")
+  if cfg.num_envs != 1:
+    raise ValueError("Tracking ONNX export currently supports only num_envs=1.")
+
+  checkpoint_path = Path(cfg.checkpoint_file)
+  if not checkpoint_path.exists():
+    raise FileNotFoundError(f"Checkpoint file not found: {checkpoint_path}")
+  onnx_path = Path(cfg.onnx_file)
+  if not onnx_path.exists():
+    raise FileNotFoundError(f"ONNX file not found: {onnx_path}")
+  motion_path = Path(cfg.motion_file)
+  if not motion_path.exists():
+    raise FileNotFoundError(f"Motion file not found: {motion_path}")
+
+  motion_cmd.motion_file = str(motion_path)
+  motion_cmd.sampling_mode = "start"
+  env_cfg.observations["actor"].enable_corruption = True
+  env_cfg.events.pop("push_robot", None)
+  env_cfg.scene.num_envs = cfg.num_envs
+
+  env = ManagerBasedRlEnv(cfg=env_cfg, device=device)
+  vec_env = RslRlVecEnvWrapper(env, clip_actions=agent_cfg.clip_actions)
+
+  runner_cls = load_runner_cls(task_id) or MjlabOnPolicyRunner
+  runner = runner_cls(vec_env, asdict(agent_cfg), device=device)
+  runner.load(str(checkpoint_path), map_location=device)
+  pt_policy = runner.get_inference_policy(device=device)
+
+  session = ort.InferenceSession(
+    str(onnx_path),
+    providers=["CPUExecutionProvider"],
+  )
+  command = cast(MotionCommand, env.command_manager.get_term("motion"))
+
+  obs = vec_env.get_observations()
+  env.command_manager.compute(dt=env.step_dt)
+
+  abs_diffs: list[torch.Tensor] = []
+  l2_diffs: list[torch.Tensor] = []
+
+  for _ in range(cfg.num_steps):
+    with torch.no_grad():
+      pt_actions = pt_policy(obs)
+
+    actor_obs = obs["actor"] if hasattr(obs, "keys") and "actor" in obs.keys() else obs
+    obs_np = actor_obs.detach().cpu().numpy().astype(np.float32, copy=False)
+    time_step_np = (
+      command.time_steps.unsqueeze(-1).detach().cpu().numpy().astype(np.float32, copy=False)
+    )
+    onnx_actions_np = session.run(
+      ["actions"], {"obs": obs_np, "time_step": time_step_np}
+    )[0]
+    onnx_actions = torch.from_numpy(np.asarray(onnx_actions_np)).to(device=device)
+
+    diff = (pt_actions - onnx_actions).abs()
+    abs_diffs.append(diff.detach().cpu())
+    l2_diffs.append(torch.linalg.vector_norm(diff, dim=1).detach().cpu())
+
+    obs, _, _, _ = vec_env.step(pt_actions)
+
+  abs_stack = torch.cat([d.reshape(-1) for d in abs_diffs], dim=0)
+  l2_stack = torch.cat(l2_diffs, dim=0)
+  summary = {
+    "num_envs": int(cfg.num_envs),
+    "num_steps": int(cfg.num_steps),
+    "mean_abs_action_diff": float(abs_stack.mean().item()),
+    "p95_abs_action_diff": float(torch.quantile(abs_stack, 0.95).item()),
+    "max_abs_action_diff": float(abs_stack.max().item()),
+    "mean_l2_action_diff": float(l2_stack.mean().item()),
+    "max_l2_action_diff": float(l2_stack.max().item()),
+  }
+
+  print(json.dumps(summary, indent=2))
+
+  if cfg.output_file:
+    output_path = Path(cfg.output_file)
+    output_path.parent.mkdir(parents=True, exist_ok=True)
+    output_path.write_text(json.dumps(summary, indent=2))
+
+  env.close()
+  return summary
+
+
+def main() -> None:
+  import mjlab
+  import mjlab.tasks  # noqa: F401
+
+  tracking_tasks = [t for t in list_tasks() if "Tracking" in t]
+  if not tracking_tasks:
+    print("No tracking tasks found.")
+    sys.exit(1)
+
+  chosen_task, remaining_args = tyro.cli(
+    tyro.extras.literal_type_from_choices(tracking_tasks),
+    add_help=False,
+    return_unknown_args=True,
+    config=mjlab.TYRO_FLAGS,
+  )
+
+  args = tyro.cli(
+    ComparePtOnnxConfig,
+    args=remaining_args,
+    prog=sys.argv[0] + f" {chosen_task}",
+    config=mjlab.TYRO_FLAGS,
+  )
+  run_compare_pt_onnx(chosen_task, args)
+
+
+if __name__ == "__main__":
+  main()
