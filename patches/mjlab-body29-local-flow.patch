+"""Export a tracking checkpoint to an actor-only ONNX file with metadata."""
+
+from __future__ import annotations
+
+import os
+import sys
+from dataclasses import asdict, dataclass
+from pathlib import Path
+from typing import cast
+
+import torch
+import tyro
+
+from mjlab.envs import ManagerBasedRlEnv
+from mjlab.rl import MjlabOnPolicyRunner, RslRlVecEnvWrapper
+from mjlab.rl.exporter_utils import attach_metadata_to_onnx, get_base_metadata
+from mjlab.tasks.registry import list_tasks, load_env_cfg, load_rl_cfg, load_runner_cls
+from mjlab.tasks.tracking.mdp import MotionCommandCfg
+from mjlab.tasks.tracking.mdp.commands import MotionCommand
+from mjlab.tasks.tracking.rl.runner import MotionTrackingOnPolicyRunner
+from mjlab.utils.torch import configure_torch_backends
+
+
+@dataclass(frozen=True)
+class ExportTrackingOnnxConfig:
+  checkpoint_file: str
+  motion_file: str
+  output_file: str | None = None
+  device: str | None = None
+
+
+def run_export_tracking_onnx(task_id: str, cfg: ExportTrackingOnnxConfig) -> str:
+  configure_torch_backends()
+  device = cfg.device or ("cuda:0" if torch.cuda.is_available() else "cpu")
+
+  env_cfg = load_env_cfg(task_id, play=True)
+  agent_cfg = load_rl_cfg(task_id)
+
+  motion_cmd = env_cfg.commands.get("motion")
+  if not isinstance(motion_cmd, MotionCommandCfg):
+    raise ValueError(f"Task {task_id} is not a tracking task.")
+
+  checkpoint_path = Path(cfg.checkpoint_file)
+  motion_path = Path(cfg.motion_file)
+  if not checkpoint_path.exists():
+    raise FileNotFoundError(f"Checkpoint file not found: {checkpoint_path}")
+  if not motion_path.exists():
+    raise FileNotFoundError(f"Motion file not found: {motion_path}")
+
+  motion_cmd.motion_file = str(motion_path)
+  motion_cmd.sampling_mode = "start"
+  env_cfg.scene.num_envs = 1
+  env_cfg.observations["actor"].enable_corruption = False
+  env_cfg.events.pop("push_robot", None)
+
+  env = ManagerBasedRlEnv(cfg=env_cfg, device=device)
+  vec_env = RslRlVecEnvWrapper(env, clip_actions=agent_cfg.clip_actions)
+
+  runner_cls = load_runner_cls(task_id) or MotionTrackingOnPolicyRunner
+  if not issubclass(runner_cls, MjlabOnPolicyRunner):
+    raise RuntimeError(f"Runner for {task_id} is not an MjlabOnPolicyRunner.")
+  runner = runner_cls(vec_env, asdict(agent_cfg), device=device)
+  runner.load(str(checkpoint_path), map_location=device)
+
+  if cfg.output_file is None:
+    output_file = checkpoint_path.parent / f"{checkpoint_path.parent.name}.onnx"
+  else:
+    output_file = Path(cfg.output_file)
+  output_file.parent.mkdir(parents=True, exist_ok=True)
+
+  runner.export_policy_to_onnx(str(output_file.parent), output_file.name)
+
+  motion_term = cast(MotionCommand, env.command_manager.get_term("motion"))
+  robot = env.scene["robot"]
+  metadata = get_base_metadata(env, "local")
+  metadata.update(
+    {
+      "anchor_body_name": motion_term.cfg.anchor_body_name,
+      "body_names": list(motion_term.cfg.body_names),
+      "motion_source_body_names": list(robot.body_names),
+      "sim2sim_contract": "g1_moves_v1",
+      "control_dt": float(env.step_dt),
+      "sim_dt": float(env.sim.mj_model.opt.timestep),
+    }
+  )
+  attach_metadata_to_onnx(str(output_file), metadata)
+  env.close()
+  print(str(output_file))
+  return str(output_file)
+
+
+def main() -> None:
+  import mjlab
+  import mjlab.tasks  # noqa: F401
+
+  tracking_tasks = [t for t in list_tasks() if "Tracking" in t]
+  if not tracking_tasks:
+    print("No tracking tasks found.")
+    sys.exit(1)
+
+  chosen_task, remaining_args = tyro.cli(
+    tyro.extras.literal_type_from_choices(tracking_tasks),
+    add_help=False,
+    return_unknown_args=True,
+    config=mjlab.TYRO_FLAGS,
+  )
+  args = tyro.cli(
+    ExportTrackingOnnxConfig,
+    args=remaining_args,
+    prog=sys.argv[0] + f" {chosen_task}",
+    config=mjlab.TYRO_FLAGS,
+  )
+  run_export_tracking_onnx(chosen_task, args)
+
+
+if __name__ == "__main__":
+  main()
