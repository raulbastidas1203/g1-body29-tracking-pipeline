+"""Run a trained tracking policy on the Unitree MuJoCo G1 model.
+
+This provides a first sim2sim validation step: the policy is executed outside
+the mjlab environment loop, using the official `unitree_mujoco` 29-DoF G1 XML
+and ONNX inference with a simple PD torque controller.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+from dataclasses import dataclass
+from pathlib import Path
+
+import mediapy as media
+import mujoco
+import numpy as np
+import onnxruntime as ort
+import tyro
+
+from mjlab.asset_zoo.robots import G1_ACTION_SCALE
+
+
+CONTROL_DT = 0.02
+DECIMATION = 4
+DEFAULT_CONTROL_FPS = int(round(1.0 / CONTROL_DT))
+JOINT_NAMES = (
+  "left_hip_pitch_joint",
+  "left_hip_roll_joint",
+  "left_hip_yaw_joint",
+  "left_knee_joint",
+  "left_ankle_pitch_joint",
+  "left_ankle_roll_joint",
+  "right_hip_pitch_joint",
+  "right_hip_roll_joint",
+  "right_hip_yaw_joint",
+  "right_knee_joint",
+  "right_ankle_pitch_joint",
+  "right_ankle_roll_joint",
+  "waist_yaw_joint",
+  "waist_roll_joint",
+  "waist_pitch_joint",
+  "left_shoulder_pitch_joint",
+  "left_shoulder_roll_joint",
+  "left_shoulder_yaw_joint",
+  "left_elbow_joint",
+  "left_wrist_roll_joint",
+  "left_wrist_pitch_joint",
+  "left_wrist_yaw_joint",
+  "right_shoulder_pitch_joint",
+  "right_shoulder_roll_joint",
+  "right_shoulder_yaw_joint",
+  "right_elbow_joint",
+  "right_wrist_roll_joint",
+  "right_wrist_pitch_joint",
+  "right_wrist_yaw_joint",
+)
+DEFAULT_JOINT_POS = np.array(
+  [
+    -0.312,
+    0.0,
+    0.0,
+    0.669,
+    -0.363,
+    0.0,
+    -0.312,
+    0.0,
+    0.0,
+    0.669,
+    -0.363,
+    0.0,
+    0.0,
+    0.0,
+    0.0,
+    0.2,
+    0.2,
+    0.0,
+    0.6,
+    0.0,
+    0.0,
+    0.0,
+    0.2,
+    -0.2,
+    0.0,
+    0.6,
+    0.0,
+    0.0,
+    0.0,
+  ],
+  dtype=np.float32,
+)
+
+
+def build_action_scale() -> np.ndarray:
+  values: list[float] = []
+  for joint_name in JOINT_NAMES:
+    matched = False
+    for pattern, scale in G1_ACTION_SCALE.items():
+      if re.fullmatch(pattern, joint_name):
+        values.append(float(scale))
+        matched = True
+        break
+    if not matched:
+      raise KeyError(f"No action scale found for joint: {joint_name}")
+  return np.asarray(values, dtype=np.float32)
+
+
+ACTION_SCALE = build_action_scale()
+BODY_NAMES = (
+  "pelvis",
+  "left_hip_pitch_link",
+  "left_hip_roll_link",
+  "left_hip_yaw_link",
+  "left_knee_link",
+  "left_ankle_pitch_link",
+  "left_ankle_roll_link",
+  "right_hip_pitch_link",
+  "right_hip_roll_link",
+  "right_hip_yaw_link",
+  "right_knee_link",
+  "right_ankle_pitch_link",
+  "right_ankle_roll_link",
+  "waist_yaw_link",
+  "waist_roll_link",
+  "torso_link",
+  "left_shoulder_pitch_link",
+  "left_shoulder_roll_link",
+  "left_shoulder_yaw_link",
+  "left_elbow_link",
+  "left_wrist_roll_link",
+  "left_wrist_pitch_link",
+  "left_wrist_yaw_link",
+  "right_shoulder_pitch_link",
+  "right_shoulder_roll_link",
+  "right_shoulder_yaw_link",
+  "right_elbow_link",
+  "right_wrist_roll_link",
+  "right_wrist_pitch_link",
+  "right_wrist_yaw_link",
+)
+EE_BODY_NAMES = (
+  "left_ankle_roll_link",
+  "right_ankle_roll_link",
+  "left_wrist_yaw_link",
+  "right_wrist_yaw_link",
+)
+ANCHOR_BODY_NAME = "torso_link"
+
+# Joint gains matched to the standalone g1-moves controller and mjlab's
+# tracking setup.
+KP = np.array(
+  [
+    40.2,
+    99.1,
+    40.2,
+    99.1,
+    28.6,
+    28.6,
+    40.2,
+    99.1,
+    40.2,
+    99.1,
+    28.6,
+    28.6,
+    40.2,
+    28.6,
+    28.6,
+    14.3,
+    14.3,
+    14.3,
+    14.3,
+    14.3,
+    16.8,
+    16.8,
+    14.3,
+    14.3,
+    14.3,
+    14.3,
+    14.3,
+    16.8,
+    16.8,
+  ],
+  dtype=np.float32,
+)
+KD = np.array(
+  [
+    2.6,
+    6.3,
+    2.6,
+    6.3,
+    1.8,
+    1.8,
+    2.6,
+    6.3,
+    2.6,
+    6.3,
+    1.8,
+    1.8,
+    2.6,
+    1.8,
+    1.8,
+    0.9,
+    0.9,
+    0.9,
+    0.9,
+    0.9,
+    1.1,
+    1.1,
+    0.9,
+    0.9,
+    0.9,
+    0.9,
+    0.9,
+    1.1,
+    1.1,
+  ],
+  dtype=np.float32,
+)
+
+
+@dataclass(frozen=True)
+class Sim2SimConfig:
+  onnx_file: str
+  motion_file: str
+  xml_file: str
+  output_video: str
+  output_metrics: str | None = None
+  num_steps: int | None = None
+  video_height: int = 720
+  video_width: int = 1280
+  onnx_provider: str = "cpu"
+
+
+def quat_to_rot_matrix(quat_wxyz: np.ndarray) -> np.ndarray:
+  quat = np.asarray(quat_wxyz, dtype=np.float64)
+  quat = quat / np.linalg.norm(quat)
+  w, x, y, z = quat
+  return np.array(
+    [
+      [1 - 2 * (y * y + z * z), 2 * (x * y - w * z), 2 * (x * z + w * y)],
+      [2 * (x * y + w * z), 1 - 2 * (x * x + z * z), 2 * (y * z - w * x)],
+      [2 * (x * z - w * y), 2 * (y * z + w * x), 1 - 2 * (x * x + y * y)],
+    ],
+    dtype=np.float64,
+  )
+
+
+def rotation_matrix_to_6d(rot_matrix: np.ndarray) -> np.ndarray:
+  return rot_matrix[:, :2].T.reshape(-1).astype(np.float32)
+
+
+def quat_angle_error(ref_wxyz: np.ndarray, cur_wxyz: np.ndarray) -> float:
+  ref = np.asarray(ref_wxyz, dtype=np.float64)
+  cur = np.asarray(cur_wxyz, dtype=np.float64)
+  ref /= np.linalg.norm(ref)
+  cur /= np.linalg.norm(cur)
+  dot = np.abs(float(np.dot(ref, cur)))
+  dot = np.clip(dot, -1.0, 1.0)
+  return float(2.0 * np.arccos(dot))
+
+
+def sensor_values(model: mujoco.MjModel, data: mujoco.MjData, name: str) -> np.ndarray:
+  sensor_id = mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_SENSOR, name)
+  if sensor_id < 0:
+    raise KeyError(f"Sensor not found: {name}")
+  adr = model.sensor_adr[sensor_id]
+  dim = model.sensor_dim[sensor_id]
+  return np.asarray(data.sensordata[adr : adr + dim], dtype=np.float32).copy()
+
+
+def body_id(model: mujoco.MjModel, name: str) -> int:
+  idx = mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_BODY, name)
+  if idx < 0:
+    raise KeyError(f"Body not found: {name}")
+  return idx
+
+
+def run_sim2sim(cfg: Sim2SimConfig) -> dict[str, float | int | bool | str]:
+  motion_path = Path(cfg.motion_file)
+  onnx_path = Path(cfg.onnx_file)
+  xml_path = Path(cfg.xml_file)
+  if not motion_path.exists():
+    raise FileNotFoundError(f"Motion file not found: {motion_path}")
+  if not onnx_path.exists():
+    raise FileNotFoundError(f"ONNX file not found: {onnx_path}")
+  if not xml_path.exists():
+    raise FileNotFoundError(f"XML file not found: {xml_path}")
+
+  motion = np.load(motion_path)
+  ref_joint_pos = motion["joint_pos"].astype(np.float32)
+  ref_joint_vel = motion["joint_vel"].astype(np.float32)
+  ref_body_pos = motion["body_pos_w"].astype(np.float32)
+  ref_body_quat = motion["body_quat_w"].astype(np.float32)
+  motion_fps = float(np.asarray(motion["fps"]).reshape(-1)[0])
+  num_motion_frames = int(ref_joint_pos.shape[0])
+
+  providers = (
+    ["CUDAExecutionProvider", "CPUExecutionProvider"]
+    if cfg.onnx_provider == "cuda"
+    else ["CPUExecutionProvider"]
+  )
+  session = ort.InferenceSession(str(onnx_path), providers=providers)
+
+  model = mujoco.MjModel.from_xml_path(str(xml_path))
+  data = mujoco.MjData(model)
+  model.opt.timestep = CONTROL_DT / DECIMATION
+  model.vis.global_.offwidth = max(model.vis.global_.offwidth, cfg.video_width)
+  model.vis.global_.offheight = max(model.vis.global_.offheight, cfg.video_height)
+
+  joint_qpos_adr = np.asarray(model.jnt_qposadr[1:], dtype=np.int32)
+  joint_dof_adr = np.asarray(model.jnt_dofadr[1:], dtype=np.int32)
+  if joint_qpos_adr.shape[0] != 29 or joint_dof_adr.shape[0] != 29:
+    raise ValueError("Expected a 29-DoF G1 model in Unitree MuJoCo XML.")
+
+  expected_body_count = len(BODY_NAMES)
+  if ref_body_pos.shape[1] != expected_body_count:
+    raise ValueError(
+      f"Expected motion body_pos_w to contain {expected_body_count} bodies, "
+      f"got {ref_body_pos.shape[1]}."
+    )
+
+  anchor_index = body_id(model, ANCHOR_BODY_NAME) - 1
+  ee_indices = np.array([body_id(model, name) - 1 for name in EE_BODY_NAMES], dtype=np.int32)
+
+  # Initialize the simulator from the first reference frame.
+  data.qpos[:3] = ref_body_pos[0, 0]
+  data.qpos[3:7] = ref_body_quat[0, 0]
+  data.qpos[joint_qpos_adr] = ref_joint_pos[0]
+  data.qvel[:] = 0.0
+  mujoco.mj_forward(model, data)
+
+  renderer = mujoco.Renderer(model, height=cfg.video_height, width=cfg.video_width)
+
+  num_steps = cfg.num_steps or num_motion_frames
+  last_action = np.zeros(29, dtype=np.float32)
+  frames: list[np.ndarray] = []
+
+  mpkpe_values: list[float] = []
+  r_mpkpe_values: list[float] = []
+  joint_vel_values: list[float] = []
+  ee_pos_values: list[float] = []
+  ee_ori_values: list[float] = []
+  anchor_pos_values: list[float] = []
+  anchor_xy_values: list[float] = []
+  pelvis_height_values: list[float] = []
+  fell = False
+
+  for step in range(num_steps):
+    motion_time = step * CONTROL_DT
+    frame = min(int(motion_time * motion_fps), num_motion_frames - 1)
+
+    robot_pos = np.asarray(data.qpos[:3], dtype=np.float32).copy()
+    robot_quat_wxyz = np.asarray(data.qpos[3:7], dtype=np.float32).copy()
+    joint_pos = np.asarray(data.qpos[joint_qpos_adr], dtype=np.float32).copy()
+    joint_vel = np.asarray(data.qvel[joint_dof_adr], dtype=np.float32).copy()
+    base_ang_vel = sensor_values(model, data, "imu_gyro")
+    robot_rot = quat_to_rot_matrix(robot_quat_wxyz)
+    base_lin_vel = sensor_values(model, data, "frame_vel")
+
+    ref_anchor_pos_w = ref_body_pos[frame, anchor_index].astype(np.float64)
+    ref_anchor_quat_wxyz = ref_body_quat[frame, anchor_index].astype(np.float64)
+    anchor_delta_w = ref_anchor_pos_w - robot_pos.astype(np.float64)
+    anchor_pos_b = (robot_rot.T @ anchor_delta_w).astype(np.float32)
+    ref_anchor_rot = quat_to_rot_matrix(ref_anchor_quat_wxyz)
+    anchor_ori_b = rotation_matrix_to_6d(robot_rot.T @ ref_anchor_rot)
+
+    obs = np.concatenate(
+      [
+        ref_joint_pos[frame],
+        ref_joint_vel[frame],
+        anchor_pos_b,
+        anchor_ori_b,
+        base_ang_vel,
+        base_lin_vel,
+        joint_pos - DEFAULT_JOINT_POS,
+        joint_vel,
+        last_action,
+      ]
+    ).astype(np.float32)
+
+    time_step = np.asarray([[float(frame)]], dtype=np.float32)
+    actions = session.run(["actions"], {"obs": obs[None], "time_step": time_step})[0][
+      0
+    ].astype(np.float32)
+    last_action = actions.copy()
+
+    target_pos = actions * ACTION_SCALE + DEFAULT_JOINT_POS
+    torques = KP * (target_pos - joint_pos) - KD * joint_vel
+    data.ctrl[:] = torques
+
+    for _ in range(DECIMATION):
+      mujoco.mj_step(model, data)
+
+    current_body_pos = np.asarray(data.xpos[1:], dtype=np.float32).copy()
+    current_body_quat = np.asarray(data.xquat[1:], dtype=np.float32).copy()
+    ref_body_pos_frame = ref_body_pos[frame]
+    ref_body_quat_frame = ref_body_quat[frame]
+
+    body_error = np.linalg.norm(current_body_pos - ref_body_pos_frame, axis=1)
+    mpkpe_values.append(float(body_error.mean()))
+
+    robot_anchor = current_body_pos[anchor_index]
+    ref_anchor = ref_body_pos_frame[anchor_index]
+    rel_error = np.linalg.norm(
+      (current_body_pos - robot_anchor[None, :])
+      - (ref_body_pos_frame - ref_anchor[None, :]),
+      axis=1,
+    )
+    r_mpkpe_values.append(float(rel_error.mean()))
+
+    joint_vel_values.append(float(np.linalg.norm(ref_joint_vel[frame] - joint_vel)))
+    ee_pos_values.append(
+      float(
+        np.linalg.norm(
+          current_body_pos[ee_indices] - ref_body_pos_frame[ee_indices], axis=1
+        ).mean()
+      )
+    )
+    ee_ori_values.append(
+      float(
+        np.mean(
+          [
+            quat_angle_error(ref_body_quat_frame[idx], current_body_quat[idx])
+            for idx in ee_indices
+          ]
+        )
+      )
+    )
+    anchor_pos_values.append(float(np.linalg.norm(robot_anchor - ref_anchor)))
+    anchor_xy_values.append(float(np.linalg.norm(robot_anchor[:2] - ref_anchor[:2])))
+    pelvis_height = float(current_body_pos[0, 2])
+    pelvis_height_values.append(pelvis_height)
+    fell = fell or pelvis_height < 0.35
+
+    renderer.update_scene(data)
+    frames.append(renderer.render().copy())
+
+  output_video = Path(cfg.output_video)
+  output_video.parent.mkdir(parents=True, exist_ok=True)
+  media.write_video(str(output_video), frames, fps=DEFAULT_CONTROL_FPS)
+
+  summary: dict[str, float | int | bool | str] = {
+    "num_steps_requested": int(num_steps),
+    "num_steps_recorded": int(num_steps),
+    "num_frames": int(len(frames)),
+    "motion_fps": motion_fps,
+    "control_dt": CONTROL_DT,
+    "decimation": DECIMATION,
+    "onnx_provider": cfg.onnx_provider,
+    "body_mpkpe": float(np.mean(mpkpe_values)) if mpkpe_values else 0.0,
+    "r_mpkpe": float(np.mean(r_mpkpe_values)) if r_mpkpe_values else 0.0,
+    "joint_vel_error": float(np.mean(joint_vel_values)) if joint_vel_values else 0.0,
+    "ee_pos_error": float(np.mean(ee_pos_values)) if ee_pos_values else 0.0,
+    "ee_ori_error": float(np.mean(ee_ori_values)) if ee_ori_values else 0.0,
+    "anchor_pos_error": float(np.mean(anchor_pos_values)) if anchor_pos_values else 0.0,
+    "anchor_xy_error": float(np.mean(anchor_xy_values)) if anchor_xy_values else 0.0,
+    "min_pelvis_height": float(np.min(pelvis_height_values)) if pelvis_height_values else 0.0,
+    "fell": bool(fell),
+  }
+
+  if cfg.output_metrics is not None:
+    output_metrics = Path(cfg.output_metrics)
+    output_metrics.parent.mkdir(parents=True, exist_ok=True)
+    with output_metrics.open("w") as f:
+      json.dump(summary, f, indent=2)
+
+  renderer.close()
+  return summary
+
+
+def main() -> None:
+  cfg = tyro.cli(Sim2SimConfig)
+  summary = run_sim2sim(cfg)
+  print(json.dumps(summary, indent=2))
+
+
+if __name__ == "__main__":
+  main()
