+class _OnnxActorModel(nn.Module):
+  """ONNX-exportable actor with observation normalization baked in."""
+
+  def __init__(self, actor_critic: nn.Module):
+    super().__init__()
+    self.normalizer = actor_critic.actor_obs_normalizer
+    self.actor = actor_critic.actor
+    self.input_size = None
+    for layer in self.actor:
+      if isinstance(layer, nn.Linear):
+        self.input_size = layer.in_features
+        break
+    if self.input_size is None:
+      raise RuntimeError("Could not infer actor input size for ONNX export.")
+
+  def forward(self, x):
+    return self.actor(self.normalizer(x))
+
