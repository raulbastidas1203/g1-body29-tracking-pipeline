+def unitree_g1_flat_tracking_precise_root_env_cfg(
+  has_state_estimation: bool = True,
+  play: bool = False,
+) -> ManagerBasedRlEnvCfg:
+  """Create a stricter G1 tracking configuration with tighter root XY tracking.
+
+  This variant is tuned for single-clip imitation where visible global drift is
+  more problematic than robustness to lateral disturbances.
+  """
+  cfg = unitree_g1_flat_tracking_env_cfg(
+    has_state_estimation=has_state_estimation,
+    play=play,
+  )
+
+  motion_cmd = cfg.commands["motion"]
+  assert isinstance(motion_cmd, MotionCommandCfg)
+
+  # Keep the clip aligned in world XY during training so the policy cannot
+  # "cheat" by matching relative pose while walking away from the reference.
+  motion_cmd.pose_range = {
+    "z": (-0.005, 0.005),
+    "roll": (-0.05, 0.05),
+    "pitch": (-0.05, 0.05),
+    "yaw": (-0.08, 0.08),
+  }
+  motion_cmd.velocity_range = {
+    "z": (-0.1, 0.1),
+    "roll": (-0.2, 0.2),
+    "pitch": (-0.2, 0.2),
+    "yaw": (-0.3, 0.3),
+  }
+
+  # Increase the incentive to stay on the reference root trajectory.
+  cfg.rewards["motion_global_root_pos"].weight = 2.0
+  cfg.rewards["motion_global_root_ori"].weight = 1.5
+
+  # Single-clip training does not need periodic pushes; they encourage
+  # unnecessary recovery steps and visible drift.
+  cfg.events.pop("push_robot", None)
+
+  # Reject episodes that drift too far from the root target in full XYZ,
+  # not only in height.
+  cfg.terminations["anchor_pos"].func = bad_anchor_pos
+  cfg.terminations["anchor_pos"].params["threshold"] = 0.12
+
+  # Tighten the body-height mismatch slightly to discourage compensatory steps.
+  cfg.terminations["ee_body_pos"].params["threshold"] = 0.20
+
+  if play:
+    cfg.observations["actor"].enable_corruption = False
+    motion_cmd.pose_range = {}
+    motion_cmd.velocity_range = {}
+
+  return cfg
+
+
+def unitree_g1_flat_tracking_soft_root_env_cfg(
+  has_state_estimation: bool = True,
+  play: bool = False,
+) -> ManagerBasedRlEnvCfg:
+  """Create a G1 tracking configuration with a small allowed root corridor.
+
+  Compared to ``PreciseRoot``, this variant still keeps the robot close to the
+  reference in world space, but allows a little forward/backward and lateral
+  motion so the policy can solve balance corrections without overfitting to a
+  perfectly fixed root.
+  """
+  cfg = unitree_g1_flat_tracking_env_cfg(
+    has_state_estimation=has_state_estimation,
+    play=play,
+  )
+
+  motion_cmd = cfg.commands["motion"]
+  assert isinstance(motion_cmd, MotionCommandCfg)
+
+  # Keep the robot near the reference, but leave a narrow corridor for natural
+  # balance corrections in single-clip dance tracking.
+  motion_cmd.pose_range = {
+    "x": (-0.04, 0.04),
+    "y": (-0.02, 0.02),
+    "z": (-0.008, 0.008),
+    "roll": (-0.08, 0.08),
+    "pitch": (-0.08, 0.08),
+    "yaw": (-0.12, 0.12),
+  }
+  motion_cmd.velocity_range = {
+    "x": (-0.08, 0.08),
+    "y": (-0.04, 0.04),
+    "z": (-0.12, 0.12),
+    "roll": (-0.25, 0.25),
+    "pitch": (-0.25, 0.25),
+    "yaw": (-0.35, 0.35),
+  }
+
+  # Bias the agent toward staying with the ghost, but not so strongly that it
+  # starts sacrificing body tracking to satisfy a rigid root target.
+  cfg.rewards["motion_global_root_pos"].weight = 1.25
+  cfg.rewards["motion_global_root_ori"].weight = 1.0
+
+  # Single-clip training does not benefit from random pushes here.
+  cfg.events.pop("push_robot", None)
+
+  # Enforce root consistency in full XYZ, but with more tolerance than the
+  # precise-root variant.
+  cfg.terminations["anchor_pos"].func = bad_anchor_pos
+  cfg.terminations["anchor_pos"].params["threshold"] = 0.18
+  cfg.terminations["ee_body_pos"].params["threshold"] = 0.22
+
+  if play:
+    cfg.observations["actor"].enable_corruption = False
+    motion_cmd.pose_range = {}
+    motion_cmd.velocity_range = {}
+    cfg.events.pop("base_com", None)
+    cfg.events.pop("encoder_bias", None)
+    cfg.events.pop("foot_friction", None)
+
+  return cfg
+
+
+def unitree_g1_flat_tracking_soft_root_robust_env_cfg(
+  has_state_estimation: bool = True,
+  play: bool = False,
+) -> ManagerBasedRlEnvCfg:
+  """Create a softer-root variant aimed at startup-noise robustness.
+
+  This is intended as a finetuning stage after clean single-clip tracking is
+  already solved. Training gets a slightly broader root corridor and more time
+  to recover from startup offsets, while evaluation can still be done on the
+  stricter ``SoftRoot`` task.
+  """
+  cfg = unitree_g1_flat_tracking_soft_root_env_cfg(
+    has_state_estimation=has_state_estimation,
+    play=play,
+  )
+
+  motion_cmd = cfg.commands["motion"]
+  assert isinstance(motion_cmd, MotionCommandCfg)
+
+  motion_cmd.pose_range = {
+    "x": (-0.06, 0.06),
+    "y": (-0.03, 0.03),
+    "z": (-0.01, 0.01),
+    "roll": (-0.10, 0.10),
+    "pitch": (-0.10, 0.10),
+    "yaw": (-0.15, 0.15),
+  }
+  motion_cmd.velocity_range = {
+    "x": (-0.12, 0.12),
+    "y": (-0.06, 0.06),
+    "z": (-0.14, 0.14),
+    "roll": (-0.30, 0.30),
+    "pitch": (-0.30, 0.30),
+    "yaw": (-0.40, 0.40),
+  }
+
+  # Keep root tracking important so the policy does not recover by walking away.
+  cfg.rewards["motion_global_root_pos"].weight = 1.5
+  cfg.rewards["motion_global_root_ori"].weight = 1.1
+
+  # Let the policy see slightly larger recovery states during finetuning.
+  cfg.terminations["anchor_pos"].params["threshold"] = 0.22
+  cfg.terminations["ee_body_pos"].params["threshold"] = 0.24
+
+  if play:
+    cfg.observations["actor"].enable_corruption = False
+    motion_cmd.pose_range = {}
+    motion_cmd.velocity_range = {}
+    cfg.events.pop("base_com", None)
+    cfg.events.pop("encoder_bias", None)
+    cfg.events.pop("foot_friction", None)
+
+  return cfg
