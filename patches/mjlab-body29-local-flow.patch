+    os.makedirs(path, exist_ok=True)
+    model = self.alg.get_policy().as_onnx(verbose=verbose)
+    model.to("cpu")
+    model.eval()
+    torch.onnx.export(
+      model,
+      model.get_dummy_inputs(),  # type: ignore[operator]
+      os.path.join(path, filename),
+      export_params=True,
+      opset_version=18,
+      verbose=verbose,
+      input_names=model.input_names,  # type: ignore[arg-type]
+      output_names=model.output_names,  # type: ignore[arg-type]
+      dynamic_axes={},
+      dynamo=False,
+    )
+
+  def save(self, path: str, infos=None):
