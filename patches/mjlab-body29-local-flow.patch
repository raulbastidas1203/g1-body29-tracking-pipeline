diff --git a/home/raul/00_cursor/RL/research/mjlab/src/mjlab/tasks/tracking/scripts/compare_pt_onnx.py b/home/raul/00_cursor/RL/research/mjlab/src/mjlab/tasks/tracking/scripts/compare_pt_onnx.py
