+++ b/home/raul/00_cursor/RL/research/mjlab/src/mjlab/tasks/tracking/scripts/g1_moves_standalone.py
@@ -0,0 +1,349 @@
+"""Standalone MuJoCo sim2sim runner for actor-only tracking ONNX policies."""
+
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass
+from pathlib import Path
+
+import mediapy as media
+import mujoco
+import numpy as np
+import onnxruntime as ort
+import tyro
+
+from mjlab.rl.exporter_utils import get_onnx_metadata
+
+
+def rotation_matrix_to_6d(rot_matrix: np.ndarray) -> np.ndarray:
+  """Encode a 3x3 rotation matrix by its first two columns."""
+  return rot_matrix[:, :2].T.reshape(-1)
+
+
+def quat_to_rot_matrix(quat_wxyz: np.ndarray) -> np.ndarray:
+  """Convert wxyz quaternion to a 3x3 rotation matrix."""
+  w, x, y, z = quat_wxyz.astype(np.float64)
+  return np.array(
+    [
+      [1 - 2 * (y * y + z * z), 2 * (x * y - w * z), 2 * (x * z + w * y)],
+      [2 * (x * y + w * z), 1 - 2 * (x * x + z * z), 2 * (y * z - w * x)],
+      [2 * (x * z - w * y), 2 * (y * z + w * x), 1 - 2 * (x * x + y * y)],
+    ],
+    dtype=np.float64,
+  )
+
+
+def transform_to_body_frame(
+  root_pos_world: np.ndarray,
+  root_quat_world_wxyz: np.ndarray,
+  anchor_pos_world: np.ndarray,
+  anchor_quat_world_wxyz: np.ndarray,
+) -> tuple[np.ndarray, np.ndarray]:
+  """Express anchor pose in the robot root frame."""
+  root_rot = quat_to_rot_matrix(root_quat_world_wxyz)
+  anchor_rot = quat_to_rot_matrix(anchor_quat_world_wxyz)
+  delta_pos = anchor_pos_world - root_pos_world
+  anchor_pos_b = root_rot.T @ delta_pos
+  anchor_ori_b = rotation_matrix_to_6d(root_rot.T @ anchor_rot)
+  return anchor_pos_b.astype(np.float32), anchor_ori_b.astype(np.float32)
+
+
+def parse_float_list(value: str) -> np.ndarray:
+  if not value:
+    return np.asarray([], dtype=np.float32)
+  return np.asarray([float(v) for v in value.split(",")], dtype=np.float32)
+
+
+def parse_str_list(value: str) -> list[str]:
+  return [v for v in value.split(",") if v]
+
+
+def get_joint_and_ctrl_maps(model: mujoco.MjModel) -> tuple[dict[str, int], dict[str, int], dict[str, int]]:
+  joint_qpos = {}
+  joint_qvel = {}
+  ctrl_ids = {}
+
+  for joint_id in range(model.njnt):
+    joint_name = mujoco.mj_id2name(model, mujoco.mjtObj.mjOBJ_JOINT, joint_id)
+    if joint_name is None:
+      continue
+    joint_qpos[joint_name] = int(model.jnt_qposadr[joint_id])
+    joint_qvel[joint_name] = int(model.jnt_dofadr[joint_id])
+
+  for actuator_id in range(model.nu):
+    joint_id = int(model.actuator_trnid[actuator_id, 0])
+    joint_name = mujoco.mj_id2name(model, mujoco.mjtObj.mjOBJ_JOINT, joint_id)
+    if joint_name is None:
+      continue
+    ctrl_ids[joint_name] = actuator_id
+
+  return joint_qpos, joint_qvel, ctrl_ids
+
+
+def body_positions_in_anchor_frame(
+  body_pos_world: np.ndarray,
+  anchor_pos_world: np.ndarray,
+  anchor_quat_world_wxyz: np.ndarray,
+) -> np.ndarray:
+  rot = quat_to_rot_matrix(anchor_quat_world_wxyz)
+  rel = body_pos_world - anchor_pos_world[None, :]
+  return (rot.T @ rel.T).T.astype(np.float32)
+
+
+def find_site_or_body_velocity(
+  model: mujoco.MjModel,
+  data: mujoco.MjData,
+  *,
+  site_name: str,
+  body_name: str,
+) -> tuple[np.ndarray, np.ndarray]:
+  """Return angular and linear velocity in the local body/site frame."""
+  vel6 = np.zeros(6, dtype=np.float64)
+  site_id = mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_SITE, site_name)
+  if site_id >= 0:
+    mujoco.mj_objectVelocity(model, data, mujoco.mjtObj.mjOBJ_SITE, site_id, vel6, 1)
+  else:
+    body_id = mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_BODY, body_name)
+    if body_id < 0:
+      raise ValueError(f"Could not find site '{site_name}' or body '{body_name}' in XML.")
+    mujoco.mj_objectVelocity(model, data, mujoco.mjtObj.mjOBJ_BODY, body_id, vel6, 1)
+  return vel6[:3].astype(np.float32), vel6[3:].astype(np.float32)
+
+
+@dataclass(frozen=True)
+class G1MovesStandaloneConfig:
+  onnx_file: str
+  motion_file: str
+  xml_file: str
+  output_video: str
+  output_metrics: str | None = None
+  num_steps: int | None = None
+  video_height: int = 720
+  video_width: int = 1280
+  speed: float = 1.0
+
+
+def run_g1_moves_standalone(cfg: G1MovesStandaloneConfig) -> dict[str, float | int | bool]:
+  onnx_path = Path(cfg.onnx_file)
+  motion_path = Path(cfg.motion_file)
+  xml_path = Path(cfg.xml_file)
+
+  for label, path in [("ONNX", onnx_path), ("motion", motion_path), ("XML", xml_path)]:
+    if not path.exists():
+      raise FileNotFoundError(f"{label} file not found: {path}")
+
+  metadata = get_onnx_metadata(str(onnx_path))
+  if metadata.get("sim2sim_contract") != "g1_moves_v1":
+    raise ValueError(
+      f"Expected sim2sim_contract=g1_moves_v1, found {metadata.get('sim2sim_contract')!r}."
+    )
+
+  joint_names = parse_str_list(metadata["joint_names"])
+  default_joint_pos = parse_float_list(metadata["default_joint_pos"])
+  action_scale = parse_float_list(metadata["action_scale"])
+  joint_stiffness = parse_float_list(metadata["joint_stiffness"])
+  joint_damping = parse_float_list(metadata["joint_damping"])
+  body_names = parse_str_list(metadata["body_names"])
+  motion_source_body_names = parse_str_list(metadata["motion_source_body_names"])
+  anchor_body_name = metadata["anchor_body_name"]
+  control_dt = float(metadata.get("control_dt", "0.02"))
+  sim_dt = float(metadata.get("sim_dt", str(control_dt / 4.0)))
+  decimation = max(int(round(control_dt / sim_dt)), 1)
+
+  if action_scale.size == 1:
+    action_scale = np.full(len(joint_names), float(action_scale[0]), dtype=np.float32)
+
+  motion = np.load(motion_path)
+  ref_joint_pos = motion["joint_pos"].astype(np.float32)
+  ref_joint_vel = motion["joint_vel"].astype(np.float32)
+  raw_body_pos = motion["body_pos_w"].astype(np.float32)
+  raw_body_quat = motion["body_quat_w"].astype(np.float32)
+  num_frames = ref_joint_pos.shape[0]
+  fps = float(np.asarray(motion["fps"]).reshape(-1)[0])
+
+  if raw_body_pos.shape[1] == len(body_names):
+    ref_body_pos = raw_body_pos
+    ref_body_quat = raw_body_quat
+  else:
+    motion_body_indices = [motion_source_body_names.index(name) for name in body_names]
+    ref_body_pos = raw_body_pos[:, motion_body_indices]
+    ref_body_quat = raw_body_quat[:, motion_body_indices]
+  anchor_motion_index = body_names.index(anchor_body_name)
+
+  model = mujoco.MjModel.from_xml_path(str(xml_path))
+  data = mujoco.MjData(model)
+  model.opt.timestep = sim_dt
+
+  joint_qpos_map, joint_qvel_map, ctrl_map = get_joint_and_ctrl_maps(model)
+  missing_joints = [name for name in joint_names if name not in joint_qpos_map or name not in ctrl_map]
+  if missing_joints:
+    raise ValueError(f"XML is missing joints/actuators required by policy: {missing_joints}")
+
+  body_ids = []
+  for body_name in body_names:
+    body_id = mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_BODY, body_name)
+    if body_id < 0:
+      raise ValueError(f"XML body '{body_name}' required by policy was not found.")
+    body_ids.append(body_id)
+
+  anchor_body_id = mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_BODY, anchor_body_name)
+  if anchor_body_id < 0:
+    raise ValueError(f"Anchor body '{anchor_body_name}' was not found in XML.")
+
+  session = ort.InferenceSession(str(onnx_path), providers=["CPUExecutionProvider"])
+  if [inp.name for inp in session.get_inputs()] != ["obs"]:
+    raise ValueError("Standalone runner expects an actor-only ONNX with a single `obs` input.")
+
+  render_width = min(cfg.video_width, int(model.vis.global_.offwidth))
+  render_height = min(cfg.video_height, int(model.vis.global_.offheight))
+  renderer = mujoco.Renderer(model, height=render_height, width=render_width)
+  frames: list[np.ndarray] = []
+
+  last_action = np.zeros(len(joint_names), dtype=np.float32)
+  motion_time = 0.0
+  step_count = cfg.num_steps or num_frames
+  mpkpe_values: list[float] = []
+  r_mpkpe_values: list[float] = []
+  joint_vel_errors: list[float] = []
+  anchor_xy_errors: list[float] = []
+  min_anchor_height = float("inf")
+  fell = False
+
+  def motion_frame_index(t: float) -> int:
+    return min(int(t * fps), num_frames - 1)
+
+  def current_joint_state() -> tuple[np.ndarray, np.ndarray]:
+    qpos = np.asarray(
+      [data.qpos[joint_qpos_map[name]] for name in joint_names], dtype=np.float32
+    )
+    qvel = np.asarray(
+      [data.qvel[joint_qvel_map[name]] for name in joint_names], dtype=np.float32
+    )
+    return qpos, qvel
+
+  # Initialize at frame 0 so rollout starts in the reference pose.
+  data.qpos[:3] = ref_body_pos[0, anchor_motion_index]
+  data.qpos[3:7] = ref_body_quat[0, anchor_motion_index]
+  for joint_name, target in zip(joint_names, ref_joint_pos[0], strict=True):
+    data.qpos[joint_qpos_map[joint_name]] = float(target)
+  mujoco.mj_forward(model, data)
+
+  renderer.update_scene(data)
+  frames.append(renderer.render().copy())
+
+  for _ in range(step_count):
+    frame = motion_frame_index(motion_time)
+    joint_pos, joint_vel = current_joint_state()
+
+    robot_anchor_pos = data.xpos[anchor_body_id].astype(np.float32)
+    robot_anchor_quat = data.xquat[anchor_body_id].astype(np.float32)
+    anchor_pos_b, anchor_ori_b = transform_to_body_frame(
+      robot_anchor_pos,
+      robot_anchor_quat,
+      ref_body_pos[frame, anchor_motion_index],
+      ref_body_quat[frame, anchor_motion_index],
+    )
+    base_ang_vel, base_lin_vel = find_site_or_body_velocity(
+      model,
+      data,
+      site_name="imu_in_pelvis",
+      body_name=anchor_body_name,
+    )
+
+    obs = np.concatenate(
+      [
+        ref_joint_pos[frame],
+        ref_joint_vel[frame],
+        anchor_pos_b,
+        anchor_ori_b,
+        base_ang_vel,
+        base_lin_vel,
+        joint_pos - default_joint_pos,
+        joint_vel,
+        last_action,
+      ]
+    ).astype(np.float32, copy=False)
+
+    actions = session.run(["actions"], {"obs": obs[None]})[0][0].astype(np.float32)
+    last_action = actions.copy()
+
+    target_joint_pos = default_joint_pos + action_scale * actions
+    for joint_name, target_pos, kp, kd, current_pos, current_vel in zip(
+      joint_names,
+      target_joint_pos,
+      joint_stiffness,
+      joint_damping,
+      joint_pos,
+      joint_vel,
+      strict=True,
+    ):
+      ctrl_id = ctrl_map[joint_name]
+      data.ctrl[ctrl_id] = float(kp * (target_pos - current_pos) - kd * current_vel)
+
+    for _ in range(decimation):
+      mujoco.mj_step(model, data)
+
+    body_pos = data.xpos[body_ids].astype(np.float32)
+    anchor_pos = data.xpos[anchor_body_id].astype(np.float32)
+    anchor_quat = data.xquat[anchor_body_id].astype(np.float32)
+    ref_anchor_pos = ref_body_pos[frame, anchor_motion_index]
+    ref_anchor_quat = ref_body_quat[frame, anchor_motion_index]
+
+    mpkpe_values.append(float(np.linalg.norm(body_pos - ref_body_pos[frame], axis=1).mean()))
+    robot_body_b = body_positions_in_anchor_frame(body_pos, anchor_pos, anchor_quat)
+    ref_body_b = body_positions_in_anchor_frame(ref_body_pos[frame], ref_anchor_pos, ref_anchor_quat)
+    r_mpkpe_values.append(float(np.linalg.norm(robot_body_b - ref_body_b, axis=1).mean()))
+    joint_vel_errors.append(float(np.linalg.norm(joint_vel - ref_joint_vel[frame])))
+    anchor_xy_error = float(np.linalg.norm(anchor_pos[:2] - ref_anchor_pos[:2]))
+    anchor_xy_errors.append(anchor_xy_error)
+    min_anchor_height = min(min_anchor_height, float(anchor_pos[2]))
+    if anchor_pos[2] < 0.2:
+      fell = True
+
+    renderer.update_scene(data)
+    frames.append(renderer.render().copy())
+    motion_time += control_dt * cfg.speed
+
+    if fell:
+      break
+
+  renderer.close()
+
+  output_video = Path(cfg.output_video)
+  output_video.parent.mkdir(parents=True, exist_ok=True)
+  media.write_video(str(output_video), frames, fps=max(int(round(1.0 / control_dt)), 1))
+
+  summary: dict[str, float | int | bool] = {
+    "num_steps_requested": int(step_count),
+    "num_steps_recorded": int(len(mpkpe_values)),
+    "num_frames": int(len(frames)),
+    "video_width": int(render_width),
+    "video_height": int(render_height),
+    "fell": fell,
+    "mpkpe": float(np.mean(mpkpe_values)) if mpkpe_values else 0.0,
+    "r_mpkpe": float(np.mean(r_mpkpe_values)) if r_mpkpe_values else 0.0,
+    "joint_vel_error": float(np.mean(joint_vel_errors)) if joint_vel_errors else 0.0,
+    "anchor_xy_error": float(np.mean(anchor_xy_errors)) if anchor_xy_errors else 0.0,
+    "anchor_xy_error_max": float(np.max(anchor_xy_errors)) if anchor_xy_errors else 0.0,
+    "min_anchor_height": float(min_anchor_height) if np.isfinite(min_anchor_height) else 0.0,
+    "xml_file": str(xml_path),
+    "motion_file": str(motion_path),
+    "onnx_file": str(onnx_path),
+  }
+
+  if cfg.output_metrics is not None:
+    output_metrics = Path(cfg.output_metrics)
+    output_metrics.parent.mkdir(parents=True, exist_ok=True)
+    output_metrics.write_text(json.dumps(summary, indent=2))
+
+  print(json.dumps(summary, indent=2))
+  return summary
+
+
+def main() -> None:
+  cfg = tyro.cli(G1MovesStandaloneConfig)
+  run_g1_moves_standalone(cfg)
+
+
+if __name__ == "__main__":
+  main()
