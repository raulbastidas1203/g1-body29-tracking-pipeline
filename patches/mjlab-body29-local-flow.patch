@@ -0,0 +1,188 @@
+"""Record a policy rollout for a tracking task with optional ghost-reference overlay."""
+
+from __future__ import annotations
+
+import json
+import sys
+from dataclasses import asdict, dataclass
+from pathlib import Path
+
+import mediapy as media
+import mjlab
+import numpy as np
+import torch
+import tyro
+
+from mjlab.envs import ManagerBasedRlEnv
+from mjlab.rl import MjlabOnPolicyRunner, RslRlVecEnvWrapper
+from mjlab.tasks.registry import list_tasks, load_env_cfg, load_rl_cfg, load_runner_cls
+from mjlab.tasks.tracking.mdp import MotionCommandCfg
+from mjlab.tasks.tracking.mdp.commands import MotionCommand
+from mjlab.tasks.tracking.mdp.metrics import (
+  compute_ee_orientation_error,
+  compute_ee_position_error,
+  compute_joint_velocity_error,
+  compute_mpkpe,
+  compute_root_relative_mpkpe,
+)
+from mjlab.utils.torch import configure_torch_backends
+
+
+@dataclass(frozen=True)
+class RecordRolloutConfig:
+  checkpoint_file: str
+  motion_file: str
+  output_video: str
+  output_metrics: str | None = None
+  num_steps: int | None = None
+  device: str | None = None
+  num_envs: int = 1
+  video_height: int = 720
+  video_width: int = 1280
+  no_terminations: bool = False
+
+
+def run_record_rollout(task_id: str, cfg: RecordRolloutConfig) -> dict[str, float | int | bool]:
+  configure_torch_backends()
+  device = cfg.device or ("cuda:0" if torch.cuda.is_available() else "cpu")
+
+  env_cfg = load_env_cfg(task_id, play=True)
+  agent_cfg = load_rl_cfg(task_id)
+
+  motion_cmd = env_cfg.commands.get("motion")
+  if not isinstance(motion_cmd, MotionCommandCfg):
+    raise ValueError(f"Task {task_id} is not a tracking task.")
+
+  checkpoint_path = Path(cfg.checkpoint_file)
+  if not checkpoint_path.exists():
+    raise FileNotFoundError(f"Checkpoint file not found: {checkpoint_path}")
+  motion_path = Path(cfg.motion_file)
+  if not motion_path.exists():
+    raise FileNotFoundError(f"Motion file not found: {motion_path}")
+
+  motion_cmd.motion_file = str(motion_path)
+  motion_cmd.joint_position_range = (0.0, 0.0)
+  env_cfg.scene.num_envs = cfg.num_envs
+  env_cfg.viewer.height = cfg.video_height
+  env_cfg.viewer.width = cfg.video_width
+  env_cfg.viewer.env_idx = 0
+  env_cfg.observations["actor"].enable_corruption = False
+  ee_term_cfg = env_cfg.terminations.get("ee_body_pos")
+  if cfg.no_terminations:
+    env_cfg.terminations = {}
+
+  env = ManagerBasedRlEnv(cfg=env_cfg, device=device, render_mode="rgb_array")
+  vec_env = RslRlVecEnvWrapper(env, clip_actions=agent_cfg.clip_actions)
+
+  runner_cls = load_runner_cls(task_id) or MjlabOnPolicyRunner
+  runner = runner_cls(vec_env, asdict(agent_cfg), device=device)
+  runner.load(str(checkpoint_path), map_location=device)
+  policy = runner.get_inference_policy(device=device)
+
+  command = env.command_manager.get_term("motion")
+  if not isinstance(command, MotionCommand):
+    raise RuntimeError("Motion command was not initialized as expected.")
+
+  ee_body_names = () if ee_term_cfg is None else ee_term_cfg.params["body_names"]
+
+  num_steps = cfg.num_steps or command.motion.time_step_total
+  frames: list[np.ndarray] = []
+  mpkpe_values: list[float] = []
+  r_mpkpe_values: list[float] = []
+  joint_vel_values: list[float] = []
+  ee_pos_values: list[float] = []
+  ee_ori_values: list[float] = []
+
+  obs = vec_env.get_observations()
+
+  initial_frame = env.render()
+  if initial_frame is not None:
+    frames.append(initial_frame[0] if initial_frame.ndim == 4 else initial_frame)
+
+  terminated_early = False
+  truncated_early = False
+  completed_steps = 0
+
+  for step in range(num_steps):
+    with torch.no_grad():
+      actions = policy(obs)
+    obs, _, dones, extras = vec_env.step(actions)
+
+    mpkpe_values.append(float(compute_mpkpe(command)[0].item()))
+    r_mpkpe_values.append(float(compute_root_relative_mpkpe(command)[0].item()))
+    joint_vel_values.append(float(compute_joint_velocity_error(command)[0].item()))
+    if ee_body_names:
+      ee_pos_values.append(float(compute_ee_position_error(command, ee_body_names)[0].item()))
+      ee_ori_values.append(float(compute_ee_orientation_error(command, ee_body_names)[0].item()))
+
+    frame = env.render()
+    if frame is not None:
+      frames.append(frame[0] if frame.ndim == 4 else frame)
+
+    completed_steps = step + 1
+    if bool(dones[0].item()):
+      terminated = bool(env.termination_manager.terminated[0].item())
+      truncated = bool(env.termination_manager.time_outs[0].item())
+      terminated_early = terminated
+      truncated_early = truncated
+      if not cfg.no_terminations:
+        break
+
+  output_video = Path(cfg.output_video)
+  output_video.parent.mkdir(parents=True, exist_ok=True)
+  if not frames:
+    raise RuntimeError("No frames were recorded.")
+  media.write_video(str(output_video), frames, fps=env.metadata.get("render_fps", 50))
+
+  summary: dict[str, float | int | bool] = {
+    "num_steps_requested": int(num_steps),
+    "num_steps_recorded": int(completed_steps),
+    "num_frames": int(len(frames)),
+    "no_terminations": bool(cfg.no_terminations),
+    "terminated_early": terminated_early,
+    "truncated_early": truncated_early,
+    "mpkpe": float(np.mean(mpkpe_values)) if mpkpe_values else 0.0,
+    "r_mpkpe": float(np.mean(r_mpkpe_values)) if r_mpkpe_values else 0.0,
+    "joint_vel_error": float(np.mean(joint_vel_values)) if joint_vel_values else 0.0,
+    "ee_pos_error": float(np.mean(ee_pos_values)) if ee_pos_values else 0.0,
+    "ee_ori_error": float(np.mean(ee_ori_values)) if ee_ori_values else 0.0,
+  }
+
+  if cfg.output_metrics is not None:
+    output_metrics = Path(cfg.output_metrics)
+    output_metrics.parent.mkdir(parents=True, exist_ok=True)
+    with output_metrics.open("w") as f:
+      json.dump(summary, f, indent=2)
+
+  env.close()
+  return summary
+
+
+def main() -> None:
+  import mjlab.tasks  # noqa: F401
+
+  tracking_tasks = [t for t in list_tasks() if "Tracking" in t]
+  if not tracking_tasks:
+    print("No tracking tasks found.")
+    sys.exit(1)
+
+  chosen_task, remaining_args = tyro.cli(
+    tyro.extras.literal_type_from_choices(tracking_tasks),
+    add_help=False,
+    return_unknown_args=True,
+    config=mjlab.TYRO_FLAGS,
+  )
+
+  args = tyro.cli(
+    RecordRolloutConfig,
+    args=remaining_args,
+    prog=sys.argv[0] + f" {chosen_task}",
+    config=mjlab.TYRO_FLAGS,
+  )
+
+  summary = run_record_rollout(chosen_task, args)
+  print(json.dumps(summary, indent=2))
+
+
+if __name__ == "__main__":
+  main()
